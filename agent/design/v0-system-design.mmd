%%{init: {'theme':'base', 'themeVariables': { 'fontFamily': 'Segoe UI, Arial', 'fontSize': '18px', 'primaryTextColor': '#ffffff', 'lineColor': '#f0f0f0', 'primaryBorderColor': '#f0f0f0', 'tertiaryColor': '#0d0d0d', 'background': '#000000'}}}%%
flowchart LR
    classDef input fill:#0d0d0d,stroke:#f0f0f0,color:#ffffff,stroke-width:2px;
    classDef model fill:#0d0d0d,stroke:#d9d9d9,color:#ffffff,stroke-width:2px;
    classDef policy fill:#0d0d0d,stroke:#d9d9d9,color:#ffffff,stroke-width:2px;
    classDef eval fill:#0d0d0d,stroke:#f4d35e,color:#ffffff,stroke-width:2px;
    classDef output fill:#0d0d0d,stroke:#ffd166,color:#ffffff,stroke-width:2px;
    classDef hidden fill:#10263d,stroke:#ffffff,color:#ffffff,stroke-width:2px;

    subgraph V0Inputs["Agent V0 inputs"]
        CI["CI status\nPass / Fail"]
        Scope["Diff scope\nSmall / Medium / Large"]
        Sens["File sensitivity\nLow / High"]
        Author["Author history\nHigh / Low"]
    end

    subgraph HiddenState["Hidden states (explicitly visible)"]
        direction TB
        S1["Safe\n(latent state)"]
        S2["Minor Defect\n(latent state)"]
        S3["Major Defect\n(latent state)"]
    end

    subgraph V0Model["Agent V0 Bayesian model"]
        Prior["Priors\nS1=0.80, S2=0.15, S3=0.05"]
        Likelihood["Likelihood tables\nP(E | S)"]
        Posterior["Posterior\nP(S | E)"]
    end

    subgraph Policies["Policy layer"]
        Baseline["Baseline\nBlock failed CI\nReview High / Large\nElse Merge"]
        PolicyA["Policy A\nMerge < 8%\nReview 8%-45%\nBlock > 45%"]
        PolicyB["Policy B\nMerge < 2%\nReview 2%-20%\nBlock > 20%"]
    end

    subgraph Eval["Evaluation and learning"]
        Cases["Synthetic labeled cases\n30 cases"]
        Metrics["Metrics\nPrecision, Recall, FP, FN, Review rate, Cost"]
        Failure["Failure analysis"]
    end

    subgraph Output["Outputs"]
        Action["Selected action\nMerge / Request Human Review / Decline / Block"]
    end

    CI --> Likelihood
    Scope --> Likelihood
    Sens --> Likelihood
    Author --> Likelihood

    Prior --> Posterior
    Likelihood --> Posterior
    Posterior --> PolicyA
    Posterior --> PolicyB

    CI --> Baseline
    Scope --> Baseline
    Sens --> Baseline
    Author --> Baseline

    Baseline --> Action
    PolicyA --> Action
    PolicyB --> Action

    Cases -->|Evidence only| Baseline
    Cases -->|Evidence only| PolicyA
    Cases -->|Evidence only| PolicyB

    Action --> Metrics
    Cases -->|Actual hidden state revealed after action| Metrics
    Metrics --> Failure

    S1 -->|latent state| Posterior
    S2 -->|latent state| Posterior
    S3 -->|latent state| Posterior

    class CI,Scope,Sens,Author input;
    class Prior,Likelihood,Posterior model;
    class Baseline,PolicyA,PolicyB policy;
    class Cases,Metrics,Failure eval;
    class Action output;
    class S1,S2,S3 hidden;

    style V0Inputs fill:#0d0d0d,stroke:#f0f0f0,color:#ffffff,stroke-width:2px;
    style HiddenState fill:#0d0d0d,stroke:#ffffff,color:#ffffff,stroke-width:2px;
    style V0Model fill:#0d0d0d,stroke:#d9d9d9,color:#ffffff,stroke-width:2px;
    style Policies fill:#0d0d0d,stroke:#d9d9d9,color:#ffffff,stroke-width:2px;
    style Eval fill:#0d0d0d,stroke:#f4d35e,color:#ffffff,stroke-width:2px;
    style Output fill:#0d0d0d,stroke:#ffd166,color:#ffffff,stroke-width:2px;

    linkStyle default stroke:#eeeeee,stroke-width:2px;
