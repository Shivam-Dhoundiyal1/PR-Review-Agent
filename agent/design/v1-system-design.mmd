%%{init: {'theme':'base', 'themeVariables': { 'fontFamily': 'Segoe UI, Arial', 'fontSize': '18px', 'primaryTextColor': '#ffffff', 'lineColor': '#f0f0f0', 'primaryBorderColor': '#f0f0f0', 'tertiaryColor': '#0d0d0d', 'background': '#000000'}}}%%
flowchart LR
    classDef v0 fill:#0d0d0d,stroke:#f0f0f0,color:#ffffff,stroke-width:2px;
    classDef v1 fill:#0d0d0d,stroke:#d9d9d9,color:#ffffff,stroke-width:2px;
    classDef hidden fill:#10263d,stroke:#ffffff,color:#ffffff,stroke-width:2px;
    classDef policy fill:#0d0d0d,stroke:#d9d9d9,color:#ffffff,stroke-width:2px;
    classDef eval fill:#0d0d0d,stroke:#f4d35e,color:#ffffff,stroke-width:2px;

    subgraph V0Core["V0 benchmark core (unchanged)"]
        V0Inputs["V0 evidence\nCI, Scope, Sensitivity, Author"]
        V0Posterior["Posterior from Bayesian model"]
        V0Policies["Baseline / Policy A / Policy B"]
    end

    subgraph V1Extensions["V1 exploratory extensions"]
        CIReliability["CI Reliability\nStable / Flaky"]
        AuthorDomain["Author Domain Match\nMatch / Mismatch"]
        ReviewLatency["Review Latency\nShort / Long"]
        RevertRate["Revert Rate\nLow / High"]
        ReviewComments["Review Comments\nClean / Actionable / Noisy"]
    end

    subgraph V1Model["V1 evidence and belief model"]
        V1Evidence["Expanded evidence set\nV0 + V1 signals"]
        V1Likelihood["Provisional likelihoods\nnot yet production-calibrated"]
        V1Posterior["Posterior distribution\nP(Safe), P(Minor), P(Major)"]
    end

    subgraph Hidden["Hidden states (explicitly visible)"]
        direction TB
        H1["Safe\n(latent state)"]
        H2["Minor Defect\n(latent state)"]
        H3["Major Defect\n(latent state)"]
    end

    subgraph Policies["Decision policies"]
        Baseline["Baseline\nunchanged"]
        PolicyA["Policy A\nunchanged thresholds"]
        PolicyB["Policy B\nunchanged thresholds"]
    end

    subgraph Eval["V1 evaluation"]
        V1Cases["Synthetic V1 cases\nlabels inherited from scenarios"]
        V1Metrics["V1 metrics\nprecision, recall, FP, FN, review rate, cost"]
        V1Failure["V1 failure analysis"]
    end

    subgraph Output["Output"]
        FinalAction["Selected action\nMerge / Request Human Review / Decline / Block"]
    end

    V0Inputs --> V0Posterior
    V0Posterior --> V0Policies

    CIReliability --> V1Evidence
    AuthorDomain --> V1Evidence
    ReviewLatency --> V1Evidence
    RevertRate --> V1Evidence
    ReviewComments --> V1Evidence

    V0Inputs --> V1Evidence
    V1Evidence --> V1Likelihood
    V1Likelihood --> V1Posterior

    H1 -->|latent state| V1Posterior
    H2 -->|latent state| V1Posterior
    H3 -->|latent state| V1Posterior

    V1Posterior --> PolicyA
    V1Posterior --> PolicyB
    V0Inputs --> Baseline
    V0Inputs --> PolicyA
    V0Inputs --> PolicyB

    Baseline --> FinalAction
    PolicyA --> FinalAction
    PolicyB --> FinalAction

    V1Cases -->|evidence only| Baseline
    V1Cases -->|evidence only| PolicyA
    V1Cases -->|evidence only| PolicyB

    FinalAction --> V1Metrics
    V1Cases -->|actual state revealed after action| V1Metrics
    V1Metrics --> V1Failure

    class V0Inputs,V0Posterior,V0Policies v0;
    class CIReliability,AuthorDomain,ReviewLatency,RevertRate,ReviewComments,V1Evidence,V1Likelihood,V1Posterior v1;
    class H1,H2,H3 hidden;
    class Baseline,PolicyA,PolicyB policy;
    class V1Cases,V1Metrics,V1Failure eval;
    class FinalAction eval;

    style V0Core fill:#0d0d0d,stroke:#f0f0f0,color:#ffffff,stroke-width:2px;
    style V1Extensions fill:#0d0d0d,stroke:#f0f0f0,color:#ffffff,stroke-width:2px;
    style V1Model fill:#0d0d0d,stroke:#d9d9d9,color:#ffffff,stroke-width:2px;
    style Hidden fill:#0d0d0d,stroke:#ffffff,color:#ffffff,stroke-width:2px;
    style Policies fill:#0d0d0d,stroke:#d9d9d9,color:#ffffff,stroke-width:2px;
    style Eval fill:#0d0d0d,stroke:#f4d35e,color:#ffffff,stroke-width:2px;
    style Output fill:#0d0d0d,stroke:#ffd166,color:#ffffff,stroke-width:2px;

    linkStyle default stroke:#eeeeee,stroke-width:2px;
